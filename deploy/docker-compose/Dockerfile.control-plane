FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /workspace
COPY harbor /workspace/harbor
COPY harbor-service-contracts /workspace/harbor-service-contracts
COPY harbor-control-plane /workspace/harbor-control-plane

WORKDIR /workspace/harbor-control-plane
RUN uv sync --no-dev

EXPOSE 8080
CMD ["uv", "run", "--no-sync", "uvicorn", "harbor_control_plane.main:app", "--host", "0.0.0.0", "--port", "8080"]
