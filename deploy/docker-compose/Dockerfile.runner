FROM docker:27-cli AS docker-cli

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

ARG ROCKETMQ_CLIENT_CPP_VERSION=2.0.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && wget -O /tmp/rocketmq-client-cpp.deb \
        "https://github.com/apache/rocketmq-client-cpp/releases/download/${ROCKETMQ_CLIENT_CPP_VERSION}/rocketmq-client-cpp-${ROCKETMQ_CLIENT_CPP_VERSION}.amd64.deb" \
    && dpkg -i /tmp/rocketmq-client-cpp.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/rocketmq-client-cpp.deb

WORKDIR /workspace
COPY harbor /workspace/harbor

WORKDIR /workspace/harbor
RUN uv sync --no-dev --extra ags --extra tke --extra rocketmq --extra cos

CMD ["uv", "run", "--no-sync", "harbor", "runner", "start", "--config", "/config/runner.toml", "--keep-alive"]
